{
  "name": "diffly",
  "private": true,
  "version": "0.2.3",
  "description": "Desktop diff tool for Windows, macOS, and Linux.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:debug": "vite build --minify false --outDir dist-debug",
    "build:ensure": "node scripts/ensure-frontend-build.mjs",
    "build:ensure:debug": "node scripts/ensure-frontend-build.mjs --debug",
    "preview": "electron-vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.electron.json --noEmit",
    "test": "npm run check && npm run test:unit",
    "test:unit": "vitest run",
    "electron:dev": "electron-vite dev",
    "electron:build": "electron-vite build",
    "electron:package": "npm run electron:package:win",
    "electron:package:win": "npm run build && electron-builder --win nsis portable --config.npmRebuild=false && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-release-portable.ps1",
    "electron:package:mac": "npm run build && electron-builder --mac dmg zip --config.npmRebuild=false",
    "electron:package:linux": "npm run build && electron-builder --linux AppImage deb --config.npmRebuild=false",
    "electron:portable": "npm run build && electron-builder --win portable --config.npmRebuild=false --config.win.compression=store && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-release-portable.ps1",
    "electron:portable:debug": "electron-vite build --mode debug && electron-builder --win portable --config.npmRebuild=false --config.win.compression=store && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-release-portable.ps1",
    "electron:package:all": "npm run build && electron-builder --config.npmRebuild=false"
  },
  "main": "out/main/main.cjs",
  "dependencies": {
    "@pierre/diffs": "^1.2.5",
    "@pierre/trees": "^1.0.0-beta.4",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^24.10.1",
    "electron": "^42.3.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "rcedit": "^5.0.2",
    "svelte": "^5.45.2",
    "svelte-check": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.diffly.desktop",
    "productName": "Diffly",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons/icon.png",
      "category": "Development",
      "maintainer": "svenbuild"
    },
    "publish": {
      "provider": "github",
      "owner": "svenbuild",
      "repo": "diffly"
    },
    "afterPack": "scripts/set-windows-icon.cjs"
  }
}
